# syntax=docker/dockerfile:1

FROM ubuntu:24.04

ARG NODE_VERSION=24.12.0

ENV DEBIAN_FRONTEND=noninteractive
ENV PATH="/root/.cargo/bin:/root/.dotnet/tools:/usr/local/bin:${PATH}"
WORKDIR /workspace/project

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    bash \
    ca-certificates \
    curl \
    git \
    gzip \
    tar \
    unzip \
    xz-utils \
  && rm -rf /var/lib/apt/lists/*

RUN printf '%s\n' \
    '#!/usr/bin/env bash' \
    'set -euo pipefail' \
    'version="${1:-${LSP_DOCKER_NODE_VERSION:-24.12.0}}"' \
    'target="/opt/node-v${version}-linux-x64"' \
    'if [ ! -x "${target}/bin/node" ]; then' \
    '  mkdir -p /opt' \
    '  curl -fsSL "https://nodejs.org/dist/v${version}/node-v${version}-linux-x64.tar.xz" | tar -xJ -C /opt' \
    'fi' \
    'ln -sf "${target}/bin/node" /usr/local/bin/node' \
    'ln -sf "${target}/bin/npm" /usr/local/bin/npm' \
    'ln -sf "${target}/bin/npx" /usr/local/bin/npx' \
    'if [ -x "${target}/bin/corepack" ]; then ln -sf "${target}/bin/corepack" /usr/local/bin/corepack; fi' \
    > /usr/local/bin/lsp-install-node \
  && chmod +x /usr/local/bin/lsp-install-node \
  && printf '%s\n' \
    '#!/usr/bin/env bash' \
    'set -euo pipefail' \
    'version="${1:-${LSP_DOCKER_JAVA_VERSION:-21}}"' \
    'apt-get update' \
    'apt-get install -y --no-install-recommends "openjdk-${version}-jdk"' \
    'rm -rf /var/lib/apt/lists/*' \
    > /usr/local/bin/lsp-install-java \
  && chmod +x /usr/local/bin/lsp-install-java \
  && lsp-install-node "${NODE_VERSION}"

CMD ["sleep", "infinity"]
