# syntax=docker/dockerfile:1

FROM ubuntu:24.04

ARG LSP_LANGUAGE
ARG JAVA_VERSION=21
ARG KOTLIN_JAVA_VERSION=25
ARG NODE_VERSION=24.12.0
ARG LUA_LS_VERSION=3.18.2
ARG KOTLIN_LSP_VERSION=262.9593.0

ENV DEBIAN_FRONTEND=noninteractive
ENV PATH="/root/.cargo/bin:/root/.dotnet/tools:/usr/local/bin:${PATH}"
WORKDIR /workspace/project

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    bash \
    ca-certificates \
    curl \
    git \
    gzip \
    tar \
    unzip \
    xz-utils \
  && rm -rf /var/lib/apt/lists/*

RUN set -eux; \
  install_node() { \
    if ! command -v node >/dev/null 2>&1; then \
      curl -fsSL "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-x64.tar.xz" \
        | tar -xJ -C /usr/local --strip-components=1; \
    fi; \
  }; \
  install_java() { \
    apt-get update; \
    apt-get install -y --no-install-recommends "openjdk-${JAVA_VERSION}-jdk"; \
    rm -rf /var/lib/apt/lists/*; \
  }; \
  case "${LSP_LANGUAGE}" in \
    typescript|javascript) \
      install_node; \
      npm install -g typescript typescript-language-server; \
      npm cache clean --force; \
      ;; \
    json) \
      install_node; \
      npm install -g vscode-langservers-extracted; \
      npm cache clean --force; \
      ;; \
    yaml) \
      install_node; \
      npm install -g yaml-language-server; \
      npm cache clean --force; \
      ;; \
    bash) \
      install_node; \
      npm install -g bash-language-server; \
      npm cache clean --force; \
      ;; \
    dockerfile) \
      install_node; \
      npm install -g dockerfile-language-server-nodejs; \
      npm cache clean --force; \
      ;; \
    python) \
      apt-get update; \
      apt-get install -y --no-install-recommends python-is-python3 python3 python3-pip python3-venv; \
      rm -rf /var/lib/apt/lists/*; \
      install_node; \
      npm install -g pyright; \
      npm cache clean --force; \
      ;; \
    php) \
      apt-get update; \
      apt-get install -y --no-install-recommends php-cli php-mbstring php-xml; \
      rm -rf /var/lib/apt/lists/*; \
      install_node; \
      npm install -g intelephense; \
      npm cache clean --force; \
      ;; \
    go) \
      apt-get update; \
      apt-get install -y --no-install-recommends golang-go; \
      rm -rf /var/lib/apt/lists/*; \
      GOBIN=/usr/local/bin go install golang.org/x/tools/gopls@latest; \
      ;; \
    rust) \
      apt-get update; \
      apt-get install -y --no-install-recommends build-essential; \
      rm -rf /var/lib/apt/lists/*; \
      curl -fsSL https://sh.rustup.rs | sh -s -- -y --profile minimal; \
      rustup component add rust-analyzer; \
      ln -s /root/.rustup/toolchains/*/bin/rust-analyzer /usr/local/bin/rust-analyzer; \
      ;; \
    java) \
      install_java; \
      mkdir -p /opt/jdtls; \
      curl -fsSL https://download.eclipse.org/jdtls/snapshots/jdt-language-server-latest.tar.gz \
        | tar -xz -C /opt/jdtls; \
      ln -s /opt/jdtls/bin/jdtls /usr/local/bin/jdtls; \
      ;; \
    c|cpp) \
      apt-get update; \
      apt-get install -y --no-install-recommends clangd; \
      rm -rf /var/lib/apt/lists/*; \
      ;; \
    ruby) \
      apt-get update; \
      apt-get install -y --no-install-recommends build-essential ruby-dev ruby-full; \
      rm -rf /var/lib/apt/lists/*; \
      gem install --no-document solargraph; \
      ;; \
    csharp) \
      apt-get update; \
      apt-get install -y --no-install-recommends dotnet-sdk-10.0; \
      rm -rf /var/lib/apt/lists/*; \
      dotnet tool install --global csharp-ls; \
      ;; \
    kotlin) \
      JAVA_VERSION="${KOTLIN_JAVA_VERSION}"; \
      install_java; \
      mkdir -p /opt/kotlin-lsp; \
      curl -fsSL "https://download-cdn.jetbrains.com/language-server/kotlin-server/${KOTLIN_LSP_VERSION}/kotlin-server-${KOTLIN_LSP_VERSION}.tar.gz" \
        | tar -xz -C /opt/kotlin-lsp --strip-components=1; \
      printf '%s\n' '#!/usr/bin/env bash' 'cd /opt/kotlin-lsp' 'exec ./bin/intellij-server --stdio "$@"' > /usr/local/bin/kotlin-lsp; \
      chmod +x /usr/local/bin/kotlin-lsp; \
      ;; \
    lua) \
      mkdir -p /opt/lua-language-server; \
      curl -fsSL "https://github.com/LuaLS/lua-language-server/releases/download/${LUA_LS_VERSION}/lua-language-server-${LUA_LS_VERSION}-linux-x64.tar.gz" \
        | tar -xz -C /opt/lua-language-server; \
      printf '%s\n' '#!/usr/bin/env bash' 'cd /opt/lua-language-server' 'exec ./bin/lua-language-server "$@"' > /usr/local/bin/lua-language-server; \
      chmod +x /usr/local/bin/lua-language-server; \
      ;; \
    *) \
      echo "Unsupported LSP_LANGUAGE: ${LSP_LANGUAGE}" >&2; \
      exit 1; \
      ;; \
  esac

CMD ["sleep", "infinity"]
